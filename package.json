{
  "name": "shape-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:icons": "tsx scripts/buildIconIndex.ts",
    "build:geometry": "tsx scripts/buildGeometryIndex.ts",
    "build:model-inputs": "tsx scripts/buildModelInputs.ts",
    "model:download": ".venv\\Scripts\\python.exe server/manage.py download",
    "model:build": ".venv\\Scripts\\python.exe server/manage.py build --device cuda",
    "model:serve": ".venv\\Scripts\\python.exe server/app.py --device cuda",
    "eval:catalog": "tsx scripts/evaluation/run.ts --catalog",
    "eval:baseline": "tsx scripts/evaluation/run.ts",
    "eval:test": "tsx --test scripts/evaluation/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "test:model": ".venv\\Scripts\\python.exe -m unittest discover -s server -p test_*.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.45.8",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.64.0",
    "@tabler/icons": "^3.45.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bootstrap-icons": "^1.13.1",
    "heroicons": "^2.2.0",
    "lucide-static": "^0.469.0",
    "remixicon": "^4.9.1",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
